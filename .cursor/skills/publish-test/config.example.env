# 复制为 config.env 并填写真实值，勿提交 config.env

# Git
GIT_BRANCH=test

# 阿里云 OSS
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=your-bucket-name
OSS_OBJECT_PREFIX=apk/test/
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
# 公共读 Bucket 的下载基础 URL，末尾不要斜杠
# 示例: https://your-bucket-name.oss-cn-beijing.aliyuncs.com
OSS_DOWNLOAD_BASE_URL=https://your-bucket-name.oss-cn-beijing.aliyuncs.com

# QQ 邮箱 SMTP
MAIL_FROM=yourname@qq.com
MAIL_AUTH_CODE=your-qq-smtp-auth-code
# 多个收件人用英文逗号分隔
MAIL_TO=colleague@example.com
